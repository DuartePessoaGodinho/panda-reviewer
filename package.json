{
  "name": "panda-reviewer",
  "version": "1.3.0",
  "description": "GitLab MR reviewer desktop app",
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "vue-tsc -p tsconfig.vue.json --noEmit && vite build",
    "build": "npm run build:main && npm run build:renderer",
    "dev:renderer": "vite",
    "dev": "npm run build:main && concurrently \"vite\" \"node scripts/start-electron-dev.cjs\"",
    "icons": "powershell -ExecutionPolicy Bypass -File scripts/generate-icons.ps1",
    "start": "npm run build && node scripts/start-electron-dev.cjs",
    "dist": "npm run build && electron-builder",
    "publish": "npm run build && electron-builder --publish always"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "concurrently": "^8.0.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "typescript": "^5.4.0",
    "vite": "^8.0.11",
    "vue-tsc": "^3.2.8"
  },
  "dependencies": {
    "@vueuse/motion": "^3.0.3",
    "diff2html": "^3.4.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.3.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.34"
  },
  "build": {
    "appId": "com.panda-reviewer.app",
    "productName": "Panda Reviewer",
    "afterPack": "scripts/patch-win-resources.cjs",
    "publish": {
      "provider": "github",
      "owner": "DuartePessoaGodinho",
      "repo": "panda-reviewer"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "dist/**/*",
      "assets/**/*"
    ]
  }
}
