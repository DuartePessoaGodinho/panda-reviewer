{
  "name": "panda-reviewer",
  "version": "1.0.0",
  "description": "GitLab MR reviewer desktop app",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json",
    "icons": "powershell -ExecutionPolicy Bypass -File scripts/generate-icons.ps1",
    "start": "npm run build && electron dist/main/main.js",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "concurrently": "^8.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "diff2html": "^3.4.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.3.0"
  },
  "build": {
    "appId": "com.panda-reviewer.app",
    "productName": "Panda Reviewer",
    "publish": {
      "provider": "github",
      "owner": "DuartePessoaGodinho",
      "repo": "panda-reviewer"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*",
      "assets/**/*"
    ]
  }
}
